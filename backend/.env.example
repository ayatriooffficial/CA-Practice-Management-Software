# ==============================================================================
# Ayatrio Backend Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection
# Enter the rotated Atlas URI here; the backend explicitly selects ayatrio_crm.
MONGODB_URI=
# CORS Origins (comma-separated or * for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://ca-practice-management-software.vercel.app

# Rate Limiting (Requests per WindowMs)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info

# ==============================================================================
# Google Drive & File Upload Configuration
# ==============================================================================
# Method 1: Google Cloud Service Account JSON Key File Path
# GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials/service-account.json
#
# Method 2: Google Cloud Service Account JSON Key string (Direct JSON string)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Method 3: OAuth2 Client Credentials & Refresh Token
# GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
#
# Optional: Root folder ID in Google Drive where category folders will be created.
# Leave as 'root' or omit to use top-level Drive storage.
GOOGLE_DRIVE_PARENT_FOLDER_ID=root

# File Upload Limits
MAX_FILE_SIZE_MB=25

# ==============================================================================
# Google OAuth 2.0 (Gmail Integration & Real Agent Center Delivery)
# ==============================================================================
# Strict Practice Email Account:
AUTHORIZED_PRACTICE_EMAIL=searchaicloud@gmail.com
# Google Cloud Console OAuth 2.0 Web Application Credentials:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized Redirect URI (must match Google Cloud Console exactly):
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==============================================================================
# Automatic Expiry Reminders (DSC & License)
# ==============================================================================
# Master switch to enable daily DSC and License expiry reminders (configurable milestones: 30d, 15d, 10d, 7d before expiry):
AUTOMATIC_EXPIRY_REMINDERS_ENABLED=false
# Live email sending switch (false = dry-run simulation mode without network send; true = real email dispatch):
AUTOMATIC_REMINDERS_REAL_SEND=false
# Automated reminder milestone intervals in days (comma-separated positive integers, e.g. 30,15,10,7):
AUTOMATIC_EXPIRY_MILESTONES=15,10
# Scheduler polling interval in milliseconds (default: 60000 = 1 minute):
AGENT_SCHEDULER_INTERVAL_MS=60000
# Background scheduler enablement flag (true = runs in-process with server):
ENABLE_BACKGROUND_SCHEDULER=true

# ==============================================================================
# WhatsApp Cloud API Configuration
# ==============================================================================
# Meta Graph API Token and Phone Number ID for WhatsApp Business Cloud API:
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook verification token for Meta webhook subscription (default: ayatrio_practice_whatsapp_verify_token):
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ayatrio_practice_whatsapp_verify_token
# Webhook app secret for HMAC-SHA256 signature verification (optional in dev, recommended in prod):
WHATSAPP_APP_SECRET=

# ==============================================================================
# Agent Center AI Integration & Automated Follow-Up Configuration
# ==============================================================================
# Base URL for AI provider (Groq / OpenAI compatible API endpoint)
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# Secret API Key (leave empty in .env.example; set in backend runtime .env or secrets)
AI_PROVIDER_API_KEY=
# Model to use (e.g., llama-3.3-70b-versatile or openai/gpt-oss-120b)
AI_PROVIDER_MODEL=llama-3.3-70b-versatile
# AI request timeout in milliseconds
AI_TIMEOUT_MS=15000
# Automatic document follow-up reminder intervals in hours (comma-separated, e.g. 24,48,72):
AGENT_FOLLOWUP_INTERVAL_HOURS=24,48,72
# Maximum reminder follow-up attempts before escalating to practice team:
AGENT_FOLLOWUP_MAX_ATTEMPTS=4
# Flag to enable background inbound Gmail reply polling:
GMAIL_INBOUND_ENABLED=false

# ==============================================================================
# PDF Signer Configuration
# ==============================================================================
# Signer provider: 'software' (default, uses dev PFX) or 'token' (hardware token stub)
PDF_SIGNER_PROVIDER=software
# Path to PKCS#12 (.pfx) certificate file for software signer provider:
PDF_SIGNER_PFX_PATH=./certs/dev-signer.pfx
# Passphrase for the PKCS#12 file (leave empty in .env.example):
PDF_SIGNER_PFX_PASSPHRASE=
# Local storage directory for uploaded originals and signed copies:
PDF_SIGNER_STORAGE_DIR=./storage/pdf-signer
