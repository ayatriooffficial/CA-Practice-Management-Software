{
  "name": "ayatrio-backend",
  "version": "1.0.0",
  "description": "Production-grade modular MVC backend for Ayatrio CRM with TypeScript, Express, and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "seed:nc": "tsx src/scripts/seed-nc.ts",
    "seed:mock-client": "tsx src/scripts/seed-mock-client.ts",
    "seed:tasks-and-clients": "tsx src/scripts/seed-tasks-and-clients.ts",
    "seed:leads": "tsx src/scripts/seed-leads.ts",
    "get-drive-token": "node scripts/get-refresh-token.js",
    "sync:atlas": "node scripts/sync-local-to-atlas.js"
  },
  "keywords": [
    "ayatrio",
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "mvc",
    "crm",
    "production-ready"
  ],
  "author": "Ayatrio Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^187.0.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
