{
  "manifest_version": 3,
  "name": "CA Practice - MCA Auto-Fill Assistant",
  "version": "1.0.1",
  "description": "Automatically fills MCA ID and Password on the Ministry of Corporate Affairs (MCA V2/V3) portal directly from CA Practice Management.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mca.gov.in/*",
    "*://mca.gov.in/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mca.gov.in/*",
        "*://mca.gov.in/*"
      ],
      "js": ["content_mca.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content_app.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CA Practice MCA Auto-Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
