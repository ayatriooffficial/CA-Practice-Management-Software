{
  "manifest_version": 3,
  "name": "CA Practice - Multi-Portal Compliance Assistant",
  "version": "2.1.0",
  "description": "Professional multi-portal auto-fill assistant for CA Practice Management. Supports MCA, GST, E-Way Bill, Income Tax, TRACES, EPFO, ESIC, Shram Suvidha, Udyam, NSWS, Startup India, IP India, DGFT, ICEGATE, FSSAI FoSCoS, and GeM portals.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mca.gov.in/*",
    "*://mca.gov.in/*",
    "*://*.gst.gov.in/*",
    "*://gst.gov.in/*",
    "*://*.ewaybillgst.gov.in/*",
    "*://ewaybillgst.gov.in/*",
    "*://*.incometax.gov.in/*",
    "*://incometax.gov.in/*",
    "*://*.tdscpc.gov.in/*",
    "*://tdscpc.gov.in/*",
    "*://*.epfindia.gov.in/*",
    "*://epfindia.gov.in/*",
    "*://*.esic.gov.in/*",
    "*://esic.gov.in/*",
    "*://*.esic.in/*",
    "*://esic.in/*",
    "*://*.shramsuvidha.gov.in/*",
    "*://shramsuvidha.gov.in/*",
    "*://*.udyamregistration.gov.in/*",
    "*://udyamregistration.gov.in/*",
    "*://*.nsws.gov.in/*",
    "*://nsws.gov.in/*",
    "*://*.startupindia.gov.in/*",
    "*://startupindia.gov.in/*",
    "*://*.ipindia.gov.in/*",
    "*://ipindia.gov.in/*",
    "*://*.ipindiaonline.gov.in/*",
    "*://ipindiaonline.gov.in/*",
    "*://*.dgft.gov.in/*",
    "*://dgft.gov.in/*",
    "*://*.icegate.gov.in/*",
    "*://icegate.gov.in/*",
    "*://*.fssai.gov.in/*",
    "*://fssai.gov.in/*",
    "*://*.foscos.fssai.gov.in/*",
    "*://foscos.fssai.gov.in/*",
    "*://*.gem.gov.in/*",
    "*://gem.gov.in/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.ayatrio.com/*",
    "https://ayatrio.com/*",
    "https://*.vercel.app/*",
    "https://*.netlify.app/*",
    "https://*.onrender.com/*",
    "https://*.railway.app/*",
    "https://*.fly.dev/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mca.gov.in/*",
        "*://mca.gov.in/*",
        "*://*.gst.gov.in/*",
        "*://gst.gov.in/*",
        "*://*.ewaybillgst.gov.in/*",
        "*://ewaybillgst.gov.in/*",
        "*://*.incometax.gov.in/*",
        "*://incometax.gov.in/*",
        "*://*.tdscpc.gov.in/*",
        "*://tdscpc.gov.in/*",
        "*://*.epfindia.gov.in/*",
        "*://epfindia.gov.in/*",
        "*://*.esic.gov.in/*",
        "*://esic.gov.in/*",
        "*://*.esic.in/*",
        "*://esic.in/*",
        "*://*.shramsuvidha.gov.in/*",
        "*://shramsuvidha.gov.in/*",
        "*://*.udyamregistration.gov.in/*",
        "*://udyamregistration.gov.in/*",
        "*://*.nsws.gov.in/*",
        "*://nsws.gov.in/*",
        "*://*.startupindia.gov.in/*",
        "*://startupindia.gov.in/*",
        "*://*.ipindia.gov.in/*",
        "*://ipindia.gov.in/*",
        "*://*.ipindiaonline.gov.in/*",
        "*://ipindiaonline.gov.in/*",
        "*://*.dgft.gov.in/*",
        "*://dgft.gov.in/*",
        "*://*.icegate.gov.in/*",
        "*://icegate.gov.in/*",
        "*://*.fssai.gov.in/*",
        "*://fssai.gov.in/*",
        "*://*.foscos.fssai.gov.in/*",
        "*://foscos.fssai.gov.in/*",
        "*://*.gem.gov.in/*",
        "*://gem.gov.in/*"
      ],
      "js": ["content_mca.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.ayatrio.com/*",
        "https://ayatrio.com/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*",
        "https://*.onrender.com/*",
        "https://*.railway.app/*",
        "https://*.fly.dev/*"
      ],
      "js": ["content_app.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CA Practice Portal Auto-Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/*",
        "src/**/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
