# Dependencies
node_modules/
*/node_modules/
package-lock.json

# Production builds
dist/
*/dist/
build/
*/build/
.next/
*/.next/
out/
*/out/

# Environment files
.env
.env.local
.env.*.local
*.env
!.env.example
!*/.env.example

# Logs & Runtime
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
.cache/

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local scratch
ayatrio-todo.txt

# Uploads & Credentials
uploads/
*/uploads/
storage/
*/storage/
credentials/
*/credentials/
*.pem
*.key
*.pfx
certs/
*/certs/

