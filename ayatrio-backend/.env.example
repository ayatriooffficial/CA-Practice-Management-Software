# ==============================================================================
# Ayatrio Backend Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/ayatrio_crm
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ayatrio_crm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ayatrio_crm

# CORS Origins (comma-separated or * for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting (Requests per WindowMs)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info

# ==============================================================================
# Google Drive & File Upload Configuration
# ==============================================================================
# Method 1: Google Cloud Service Account JSON Key File Path
# GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials/service-account.json
#
# Method 2: Google Cloud Service Account JSON Key string (Direct JSON string)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Method 3: OAuth2 Client Credentials & Refresh Token
# GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
#
# Optional: Root folder ID in Google Drive where category folders will be created.
# Leave as 'root' or omit to use top-level Drive storage.
GOOGLE_DRIVE_PARENT_FOLDER_ID=root

# File Upload Limits
MAX_FILE_SIZE_MB=25

